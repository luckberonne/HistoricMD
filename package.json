{
  "name": "historicmd",
  "displayName": "HistoricMD",
  "description": "Browse the git commit history of a Markdown file with Prev/Next navigation.",
  "version": "0.0.1",
  "publisher": "luckberonne",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/luckberonne/HistoricMD.git"
  },
  "bugs": {
    "url": "https://github.com/luckberonne/HistoricMD/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "git",
    "history",
    "diff"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "historicmd.viewHistory",
        "title": "HistoricMD: Ver historial de commits",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "historicmd.viewHistory",
          "when": "historicmd.supportedFile",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "historicmd.viewHistory",
          "when": "historicmd.supportedFile"
        }
      ]
    },
    "keybindings": [
      {
        "command": "historicmd.viewHistory",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "historicmd.supportedFile"
      }
    ],
    "configuration": {
      "title": "HistoricMD",
      "properties": {
        "historicmd.fileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["md"],
          "description": "Extensiones de archivo (sin el punto) en las que HistoricMD se activa: muestra el botón de historial, el atajo de teclado y, si está habilitado, abre el panel automáticamente. Ejemplo: [\"md\", \"markdown\", \"mdx\"]."
        },
        "historicmd.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Abre automáticamente el panel de historial al abrir un archivo con alguna de las extensiones de historicmd.fileExtensions, si está versionado en git."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  }
}
